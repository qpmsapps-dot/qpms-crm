PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Keep false in production. Enables only the legacy /api/auth/login demo route.
ENABLE_DEMO_AUTH=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ENABLE_GOOGLE_DIRECTIONS=false
MAX_GOOGLE_DIRECTIONS_CALLS=25
END_DAY_KM_AUTO_RECALC_ENABLED=false
END_DAY_KM_AUTO_RECALC_COOLDOWN_MINUTES=10
# Optional per-attendance cap for the auto-recalc job; falls back to MAX_GOOGLE_DIRECTIONS_CALLS.
END_DAY_KM_AUTO_RECALC_MAX_GOOGLE_DIRECTIONS_CALLS=
# Optional backend-only key for server-side workflow writes. Do not expose this in Vercel/frontend env.
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_USER=
EMAIL_PASS=

# Daily Operations Report email automation
REPORT_EMAIL_ENABLED=true
REPORT_EMAIL_TIMEZONE=Asia/Kolkata
REPORT_EMAIL_HOUR=9
REPORT_EMAIL_MINUTE=0
REPORT_MASTER_EMAIL_TO=
REPORT_MASTER_EMAIL_CC=
REPORT_BRANCH_HEAD_EMAIL_ENABLED=false
REPORT_BRANCH_HEAD_TN_EMAIL=
REPORT_BRANCH_HEAD_KL_EMAIL=
REPORT_BRANCH_HEAD_KA_EMAIL=
REPORT_BRANCH_HEAD_AP_EMAIL=
REPORT_BRANCH_HEAD_TG_EMAIL=
REPORT_CRON_SECRET=

# Preferred SMTP names. Existing EMAIL_USER/EMAIL_PASS are still supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
